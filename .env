# ═══════════════════════════════════════════════════════════
#  LLM Provider Config (subscription-provider pattern)
# ═══════════════════════════════════════════════════════════

# Choose your provider. Options:
#   openrouter, together, nous, huggingface  ← aggregators (200+ models)
#   openai, anthropic, deepseek, groq, ollama, zai, kimi ← direct providers
LLM_PROVIDER=zai
ZAI_API_KEY=...

# Model slug — any model your provider supports.
# Examples per provider:
#   zai:         GLM-5.1, GLM-5, GLM-5-Turbo, GLM-4.7, GLM-4.5-air, glm-4-flash
#   kimi:        kimi-k2-latest, kimi-k2.5, moonshot-v1-8k
LLM_MODEL=GLM-5.1

# API key for the chosen provider (only the matching one is needed)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# TOGETHER_API_KEY=...
# NOUS_API_KEY=...
# HF_API_KEY=hf_...
# DEEPSEEK_API_KEY=...
# GROQ_API_KEY=gsk_...
# OLLAMA_API_KEY=ollama
ZAI_API_KEY=c747d0bb4b224bb0ae5a5c1cc8b2d778.yDVAn3EHK6kZedW1
# KIMI_API_KEY=...

# Optional base-URL overrides (defaults are set in code)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# TOGETHER_BASE_URL=https://api.together.xyz/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
#   ↑ Use https://api.z.ai/api/coding/paas/v4 for GLM-5.1 / Coding Plan models
# KIMI_BASE_URL=https://api.moonshot.ai/v1
#   ↑ Use https://api.moonshot.cn/v1 for China region

# OpenRouter-specific metadata (recommended for rate limits & ranking)
# OPENROUTER_REFERER=https://your-app.com
# OPENROUTER_APP_NAME=My CRM Agent

# ═══════════════════════════════════════════════════════════
#  Messaging Gateway Config
# ═══════════════════════════════════════════════════════════

# ── Telegram ──
TELEGRAM_BOT_TOKEN=7622770829:AAH-cKbWMbSynGiI32MYq2NJLfpbR7mDHb0
# TELEGRAM_ALLOWED_USERS=123456789,987654321  # optional comma-separated user IDs
# TELEGRAM_REQUIRE_MENTION=true              # optional: only reply when @mentioned in groups

# ── WhatsApp ──
WHATSAPP_ENABLED=false
# WHATSAPP_AUTH_DIR=.whatsapp-auth           # where session credentials are saved
# WHATSAPP_ALLOW_FROM=1234567890@s.whatsapp.net  # optional comma-separated JIDs
# WHATSAPP_ALLOW_GROUPS=group-id@g.us        # optional comma-separated group JIDs
# WHATSAPP_REQUIRE_MENTION=true              # optional: only reply when @mentioned in groups

# ── Session Management ──
# SESSION_RESET_MINUTES=60                   # purge idle sessions after N minutes

# ═══════════════════════════════════════════════════════════
#  CRM Authentication (choose the method your API requires)
# ═══════════════════════════════════════════════════════════

# CRM_API_KEY=your-api-key-here
# CRM_USERNAME=your-username
# CRM_PASSWORD=your-password
CRM_BEARER_TOKEN="ZXh0ZXJuYWxkZXY6Rml0aDVmQmRmZ3NkeEhWTUF4aXpkNW9yNjhn"
