{
  "name": "crm-deepagent",
  "version": "0.1.0",
  "description": "Barebones DeepAgent for CRM API integration with subscription-provider support and messaging gateway",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "start:web": "npm --prefix web run start",
    "gateway": "tsx src/gateway-server.ts",
    "start": "node dist/index.js",
    "start:gateway": "node dist/gateway-server.js"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.4.1",
    "@langchain/core": "^1.1.49",
    "@langchain/openai": "^1.4.7",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "deepagents": "^1.10.2",
    "dotenv": "^16.4.5",
    "grammy": "^1.42.0",
    "langchain": "^1.4.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "pino": "9.14.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.1",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.21.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
