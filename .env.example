# ═══════════════════════════════════════════════════════════
#  LLM Provider Config (subscription-provider pattern)
# ═══════════════════════════════════════════════════════════

# Choose your provider. Options:
#   openrouter, together, nous, huggingface  ← aggregators (200+ models)
#   openai, anthropic, deepseek, groq, ollama, zai, kimi-coding (aliases: kimi, moonshot) ← direct
LLM_PROVIDER=openrouter

# Model slug — any model your provider supports.
# Examples per provider:
#   openrouter:  anthropic/claude-sonnet-4-5-20250929, openai/gpt-4o, google/gemini-2.5-pro
#   together:    meta-llama/Llama-3.3-70B-Instruct-Turbo, deepseek-ai/DeepSeek-V3
#   openai:      gpt-4o, gpt-4o-mini, o3-mini
#   anthropic:   claude-sonnet-4-5-20250929, claude-opus-4-5-20250929
#   deepseek:    deepseek-chat, deepseek-reasoner
#   groq:        llama-3.3-70b-versatile, mixtral-8x7b-32768
#   ollama:      llama3.2, qwen2.5, mistral
#   zai:         GLM-5.1, GLM-5, GLM-5-Turbo, GLM-4.7, GLM-4.5-air, glm-4-flash
#   kimi-coding: k3, k3-256k, kimi-for-coding, kimi-for-coding-highspeed
#   moonshot:    kimi-k2-latest, kimi-k2.5, moonshot-v1-8k
LLM_MODEL=openai/gpt-4o

# API key for the chosen provider (only the matching one is needed)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...
TOGETHER_API_KEY=...
NOUS_API_KEY=...
HF_API_KEY=hf_...
DEEPSEEK_API_KEY=...
GROQ_API_KEY=gsk_...
OLLAMA_API_KEY=ollama
ZAI_API_KEY=...
KIMI_API_KEY=...
# KIMI_CODING_API_KEY=...  # accepted alias for Kimi Code keys

# Optional base-URL overrides (defaults are set in code)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# TOGETHER_BASE_URL=https://api.together.xyz/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
#   ↑ For GLM Coding Plan subscriptions, use https://api.z.ai/api/coding/paas/v4
#   ↑ Coding Plan currently supports GLM-5.2, GLM-5-Turbo, GLM-4.7, and GLM-4.5-Air.
# KIMI_BASE_URL=https://api.kimi.com/coding
#   ↑ Kimi Code keys prefixed sk-kimi- select this automatically.
#   ↑ Legacy keys default to https://api.moonshot.ai/v1.
#   ↑ Use https://api.moonshot.cn/v1 for legacy China-region keys.

# OpenRouter-specific metadata (recommended for rate limits & ranking)
# OPENROUTER_REFERER=https://your-app.com
# OPENROUTER_APP_NAME=My CRM Agent

# ═══════════════════════════════════════════════════════════
#  Messaging Gateway Config
# ═══════════════════════════════════════════════════════════

# ── Telegram ──
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# TELEGRAM_ALLOWED_USERS=123456789,987654321  # optional comma-separated user IDs
# TELEGRAM_REQUIRE_MENTION=true              # optional: only reply when @mentioned in groups
# TELEGRAM_TYPING_INDICATOR=true             # optional: send Telegram typing action while processing
# TELEGRAM_STREAM_UPDATES=true               # optional: edit a live Telegram response while text streams

# ── WhatsApp ──
WHATSAPP_ENABLED=true
# WHATSAPP_AUTH_DIR=.whatsapp-auth           # where session credentials are saved
# WHATSAPP_ALLOW_FROM=1234567890             # optional phones/JIDs/LIDs; * allows all
# WHATSAPP_ALLOW_GROUPS=group-id@g.us        # optional comma-separated group JIDs
# WHATSAPP_REQUIRE_MENTION=true              # groups: mention, command, or reply to bot
# WHATSAPP_DEBUG=false                       # verbose Baileys logs may expose metadata
# WHATSAPP_SEND_TIMEOUT_MS=60000             # fail a stuck send after this duration
# WHATSAPP_CHUNK_DELAY_MS=300                # pacing between 4096-char chunks

# ── Session Management ──
# SESSION_RESET_MINUTES=60                   # purge idle sessions after N minutes

# ── Property PDF Branding ──
# PROPERTY_PDF_BRAND_NAME=Bonte
# PROPERTY_PDF_LOGO_PATH=/absolute/path/to/logo.png
# PROPERTY_PDF_PRIMARY_COLOR=#173f38
# PROPERTY_PDF_ACCENT_COLOR=#c7a76c

# ═══════════════════════════════════════════════════════════
#  CRM Authentication (choose the method your API requires)
# ═══════════════════════════════════════════════════════════

CRM_API_KEY=your-api-key-here
# CRM_USERNAME=your-username
# CRM_PASSWORD=your-password
# CRM_BEARER_TOKEN=your-bearer-token
